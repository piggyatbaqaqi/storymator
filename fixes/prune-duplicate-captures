#!/usr/bin/env python
"""Undo the duplicate frames two collect runs made before it deduped.

`bin/collect-captures` originally took everything in ComfyUI's temp
directory, which only ever grows -- so a second run re-copied the whole
history. `stability-light-A` and `stability-light-B` ended up sharing
22 frames with each other and with three earlier sessions.

A frame belongs to the session that recorded it **first**, because that
session's note describes the conditions it was shot under. Later
copies are noise, and their notes are wrong about them.

Per-frame keys are preserved untouched -- the operator hand-annotated
one frame's conditions, and that is the most valuable thing in the
corpus.

One-off. The tool no longer does this.
"""

from __future__ import annotations

import argparse
import glob
import json
import os
from typing import Any, Sequence

ROOT = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                    "data", "captures")


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--dry-run", action="store_true",
                    help="report what would be removed and change nothing")
    return ap


def main(argv: Sequence[str] | None = None) -> int:
    dry = build_parser().parse_args(argv).dry_run
    sessions: list[tuple[str, str, dict[str, Any]]] = []
    for manifest in sorted(glob.glob(os.path.join(ROOT, "*", "manifest.json"))):
        with open(manifest) as fh:
            data = json.load(fh)
        first = min((n["at"] for n in data.get("notes", [])), default="")
        sessions.append((first, manifest, data))
    sessions.sort()                      # earliest collect owns the frame

    owner: dict[str, str] = {}
    for _, manifest, data in sessions:
        name = os.path.basename(os.path.dirname(manifest))
        keep: list[dict[str, Any]] = []
        drop: list[dict[str, Any]] = []
        for frame in data["frames"]:
            digest = frame["sha256_16"]
            (drop if digest in owner else keep).append(frame)
            owner.setdefault(digest, name)
        if not drop:
            print(f"  {name:34s} {len(keep):3d} frames, none duplicated")
            continue
        held = sorted({owner[f["sha256_16"]] for f in drop})
        print(f"  {name:34s} {len(keep):3d} kept, {len(drop):3d} dropped "
              f"(already in {', '.join(held)})")
        if dry:
            continue
        for frame in drop:
            path = os.path.join(os.path.dirname(manifest), frame["file"])
            if os.path.exists(path):
                os.remove(path)
        data["frames"] = keep
        with open(manifest, "w") as fh:
            json.dump(data, fh, indent=2)
    if dry:
        print("\n--dry-run: nothing changed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
