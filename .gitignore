*~
*checkpoint.ipynb
.mypy_cache
nohup.out

# Environment variables (contains sensitive credentials)
.env
.skol_env
*/.skol_env

# CouchDB credentials (auto-generated, contains password hashes)
**/docker.ini

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Python packaging and distribution artifacts
build/
deb_dist/
dist/
*.egg-info/
*.egg

# Soffice locks
.~lock.*

# Generated by bin/whitakers_wordlist; 11 MB, no longer a production
# source -- see data/latin_wordlist.CITATION.md
data/latin_wordlist.txt

# bin/llm_annotate_features --log-file defaults to
# ./llm_annotate_<timestamp>.jsonl, so every run drops a per-treatment
# log in the repo root.  It is redundant: features_status carries the
# same per-treatment status and metrics durably (8 631/8 631 docs as of
# 2026-09-09), and the round file is the record of what was drawn.
llm_annotate_*.jsonl

# ComfyUI writes into this repo: extra_model_paths.yaml in the ComfyUI
# checkout points its output and user dirs here.  Tracking artifacts is
# the point, so this ignores by WHAT WROTE IT, not by directory.
#
# Kept (they record a decision you made):
#   user/default/workflows/      the workflows themselves
#   user/default/comfy.settings.json
#
# Ignored (ComfyUI wrote them; no decision behind the change):
#   __manager/cache/  17 MB of re-downloadable registry snapshots,
#                     refreshed on a timer -- 11 MB in one file
#   comfyui.db        SQLite; binary, rewritten whole, un-diffable
#   *.lock            a live lock file; git would fight the process
#   *.log             rotating logs; rotation alone makes huge diffs
user/*
!user/default/
user/default/*
!user/default/workflows/
!user/default/comfy.settings.json

# output/ stays out of git's object store: PNGs are precompressed, so
# every image is a full permanent blob, and history cannot be shrunk
# later without a force-push that breaks every clone.  Provenance is not
# lost by this -- ComfyUI embeds the full `prompt` and `workflow` JSON in
# each PNG's metadata chunks.  See docs/planning/artifact-tracking.md.
output/

# Claude Code: settings.json is shared and committed; the .local one is
# this machine's accumulated permission grants and is not.
.claude/settings.local.json
