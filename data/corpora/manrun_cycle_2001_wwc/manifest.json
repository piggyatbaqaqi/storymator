  "reading": {
    "field_sizes": "12F and 10F are FIELD SIZES, not frame counts: 2734/3281 = 1921/2305 = 0.8333 = 10/12.",
    "exif": "All files carry orientation=6, so identify reports 2305x3281 while viewers show 3281x2305. Call exif_transpose or you work on a sideways page.",
    "structure": "Two passes of one 12-drawing run cycle. Twelve graphite cleanups numbered 1-12; twelve blue roughs numbered 1..10 with 1.5 and 6.5 inserted, so the cleanup pass renumbered. Pairing confirmed by overlay, not arithmetic.",
    "asterisks": "Rough 1, 6 and 10 only; no cleanup carries one. Hypothesis: they mark keys or extremes -- 1 and 6 are half a cycle apart. PUT TO DANIEL 2026-10-13, ANSWER OUTSTANDING.",
    "ground_lines": "Faint lines at lower left of the roughs are ground lines, perhaps with a hint of shadow (Monte, 2026-10-13).",
    "absent": "No timing chart on any sheet, and no exposure sheet. Numbers and asterisks are the only annotation."
  },
  "measurements": {
    "px_per_inch": 200,
    "peg_spacing_px": [
      800.1,
      800.7
    ],
    "peg_spacing_note": "against ACME's 4-inch centres",
    "peg_geometry": "two oblong slots flanking one round hole; the round hole carries a white reinforcement patch, so detection must not assume bare paper",
    "pass_to_pass_agreement_px": 3.5,
    "registration": "Overlaying cleanup 1 on rough 1 on the raw pixel grid puts the lines on each other: the cleanup was traced in register on the same pegs. Twelve aligned pairs.",
    "do_not_reuse": "A blue-centroid vs grey-centroid comparison gave a (+148,+311) px rough-to-clean offset. It is confounded by mismatched masks, line widths and the roughs' ground lines. The overlay is the honest instrument and says registered."
  },
