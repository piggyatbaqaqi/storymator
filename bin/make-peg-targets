#!/usr/bin/env python
"""Print a sheet of small ChArUco targets to cut out and glue down.

The alternative was cutting the four 3 x 3 corners out of the existing
7 x 9 board. That works -- the corner blocks already carry disjoint
marker ids -- but it leaves two ragged edges on every piece and risks
cutting *into* an outer square, which is the one thing that would
actually matter.

    bin/make-peg-targets --out targets.png
    bin/make-peg-targets --squares 3 --square-mm 12.5 --count 4

Each board gets its own slice of the dictionary, so a detector can
always tell which piece it is looking at and a partial view still
contributes. That is the whole reason to use ChArUco here rather than
a plain checkerboard.

The sheet carries no scale bar. It advertises the distances between
*chessboard corners* on different boards instead, and the boards are
placed close enough together that the operator's calipers reach every
one of them. A corner is a point where four quadrants meet and has no
width to argue about; a printed bar has ticks 0.20 mm wide and three
defensible ways to read them, which is 0.40 % on a quantity worth
1.27 %. See docs/planning/measuring-the-printed-target.md.

**Measure it after printing.** The 7 x 9 board came out 1.27 %
oversize with a 0.15 % anisotropy between its axes, and a different
print will have a different error.
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import sys
from typing import Dict, List, Optional, Tuple

import numpy as np


def marker_ids(count: int, per_board: int,
               first: int = 0) -> List[np.ndarray]:
    """Disjoint id ranges, one per board.

    Disjoint is the point: two pieces carrying the same ids are
    indistinguishable once they are on the disc, and a detector that
    mixes them up produces a confident wrong pose rather than a
    failure.
    """
    if count < 1 or per_board < 1:
        raise ValueError("count and per_board must be positive")
    return [np.arange(first + i * per_board,
                      first + (i + 1) * per_board, dtype=np.int32)
            for i in range(count)]


def board_side_mm(squares: int, square_mm: float) -> float:
    """How big one board is, edge to edge."""
    return float(squares) * float(square_mm)


def layout(count: int, side_mm: float, margin_mm: float,
           sheet_mm: Tuple[float, float],
           caliper_mm: Optional[float] = None
           ) -> List[Tuple[float, float]]:
    """Centres for ``count`` boards on the sheet, or raise.

    Raises rather than overlapping or running off the page: a target
    silently clipped at the edge is worse than no sheet at all,
    because it looks fine until something measures it.

    With ``caliper_mm``, the boards are pulled together until the
    longest measurement on the sheet -- the diagonal between the two
    furthest printed corners -- fits the jaws. Spreading them to the
    page margins instead gives a longer baseline that cannot be
    measured, which is no baseline at all.
    """
    box = side_mm + 2.0 * margin_mm
    width, height = sheet_mm
    # Keep off the page edges and reserve the foot of the sheet for
    # the nominals.  Spreading boards to the extreme corners satisfies
    # "wholly on the sheet" and is still unusable: the bottom row
    # lands on the notes.
    left = min(PAGE_MARGIN_MM, max(0.0, (width - box) / 2.0))
    top = min(PAGE_MARGIN_MM, max(0.0, (height - box) / 2.0))
    foot = min(NOTE_SPACE_MM, max(0.0, (height - box) / 2.0))
    usable_w = width - 2.0 * left
    usable_h = height - top - foot
    across = int(usable_w // box)
    down = int(usable_h // box)
    if across * down < count:
        raise ValueError(
            f"no room on the sheet: {width:.1f} x {height:.1f} mm holds "
            f"{across} x {down} = {across * down} boards of {box:.1f} mm "
            f"including their cut margins, and {count} were asked for")

    columns = min(across, int(np.ceil(np.sqrt(count))))
    rows = int(np.ceil(count / columns))
    half = side_mm / 2.0 + margin_mm
    # The widest step that keeps every board on the page, per axis.
    reach_w = (usable_w - 2.0 * half) / max(1, columns - 1)
    reach_h = (usable_h - 2.0 * half) / max(1, rows - 1)

    if caliper_mm is None:
        def spread(n: int, lo: float, hi: float) -> List[float]:
            if n == 1:
                return [(lo + hi) / 2.0]
            step = (hi - lo - 2.0 * half) / (n - 1)
            return [lo + half + i * step for i in range(n)]

        xs = spread(columns, left, width - left)
        ys = spread(rows, top, height - foot)
    else:
        # The two furthest printed corners are diagonally opposite, so
        # a step of s puts them (s + side) * sqrt(2) apart.  That, not
        # the axis-aligned span, is what has to fit.
        reach = float(caliper_mm) / float(np.sqrt(2.0)) - side_mm
        step = min(reach, reach_w, reach_h)
        if step < box:
            raise ValueError(
                f"a {caliper_mm:.2f} mm caliper reaches {reach:.2f} mm "
                f"between the centres of {side_mm:.1f} mm boards, which "
                f"need {box:.1f} mm apart to keep their cut margins "
                f"clear; no layout fits")
        xs = _centred(columns, step, width / 2.0)
        ys = _centred(rows, step, (top + height - foot) / 2.0)

    centres = [(x, y) for y in ys for x in xs]
    return centres[:count]


def _centred(n: int, step: float, middle: float) -> List[float]:
    """``n`` positions ``step`` apart, centred on ``middle``."""
    return [middle + (i - (n - 1) / 2.0) * step for i in range(n)]


def caliper_spans(centres: List[Tuple[float, float]], squares: int,
                  square_mm: float) -> Dict[str, float]:
    """Nominal corner-to-corner distances the operator can check.

    Corner to corner, not edge to edge and not tick to tick: a
    chessboard corner is a point where four quadrants meet, so there
    is no outside/centre/inside question to get wrong.  Each span is
    between the two *furthest apart* corners of the two boards named,
    which is where a caliper naturally seats.

    The two diagonals are here for shear, not for anisotropy.  Scaling
    by sx across and sy down multiplies both diagonals by the same
    sqrt((sx^2 + sy^2) / 2), so they cannot separate an isotropic
    error from an anisotropic one.  A difference between them can only
    come from a shear, which nothing else on the sheet catches.
    """
    if len(centres) < 2:
        raise ValueError("caliper spans need at least two boards")
    # Half the extent of the (squares-1) x (squares-1) grid of interior
    # chessboard corners, which is what a detector reports.
    corner = (squares - 2) * float(square_mm) / 2.0
    xs = [x for x, _ in centres]
    ys = [y for _, y in centres]
    wide = (max(xs) - min(xs)) + 2.0 * corner
    tall = (max(ys) - min(ys)) + 2.0 * corner
    diagonal = float(np.hypot(wide, tall))
    return {"across": float(np.hypot(wide, 2.0 * corner)),
            "down": float(np.hypot(2.0 * corner, tall)),
            "diagonal_0_3": diagonal,
            "diagonal_1_2": diagonal}


# Page furniture, in millimetres: clear of the edges, and the foot of
# the sheet left for the nominals.  Nothing is reserved above a board
# any more -- its label lives inside its own cut box.
PAGE_MARGIN_MM = 15.0
NOTE_SPACE_MM = 34.0

# The label sits in the cut margin, not above it, so that a piece
# which has been cut out still says which piece it is.
#
# LABEL_CLEAR_MM is insurance, not a detection requirement.  ChArUco
# never reads the board outline: it finds the four interior ArUco
# markers, whose nearest edge is already 1.75 mm inside the board, and
# a label flush with the board edge measured 40/40 detections and 9 um
# of corner movement -- the same as no label at all.  What breaks it
# is ink *on* a marker.  The 2 mm buys room for registration error,
# ink spread and a wobbling blade, none of which that sweep modelled.
# docs/planning/labelling-the-cut-targets.md.
LABEL_EM_MM = 2.5
LABEL_CLEAR_MM = 2.0

# Where the issued serials live, relative to the repository root.
SERIAL_REGISTRY = "data/calibration/targets/serials.json"

# Marker ids below this belong to sheets already in the world:
# charuco_0001 uses 0-30 and ref 1 uses 0-15. They overlap, which is
# the fault this reservation exists to stop repeating.
RESERVED_IDS = 40

# How many markers each predefined dictionary holds. DICT_6X6_250 and
# DICT_6X6_1000 are NESTED -- every marker of the smaller is the same
# pattern at the same id in the larger -- so running out of the one
# and moving to the other costs nothing already printed. The price is
# error correction: minimum Hamming distance 11 against 9, and 5
# correction bits against 4, measured off the rendered markers.
DICTIONARY_SIZE = {"DICT_6X6_50": 50, "DICT_6X6_100": 100,
                   "DICT_6X6_250": 250, "DICT_6X6_1000": 1000,
                   "DICT_4X4_50": 50, "DICT_4X4_100": 100,
                   "DICT_4X4_250": 250, "DICT_4X4_1000": 1000,
                   "DICT_5X5_50": 50, "DICT_5X5_100": 100,
                   "DICT_5X5_250": 250, "DICT_5X5_1000": 1000,
                   "DICT_7X7_50": 50, "DICT_7X7_100": 100,
                   "DICT_7X7_250": 250, "DICT_7X7_1000": 1000}


def load_registry(path: str) -> dict:
    """The issued serials, or raise if the file is not there.

    Raises rather than starting an empty registry: a mistyped path
    that quietly begins again at ref_1 would hand a live sheet's
    number to a new one, which is the one thing a serial must never
    do.
    """
    if not os.path.exists(path):
        raise ValueError(
            f"no serial registry at {path!r}; every sheet is issued from "
            f"one, so a missing registry is a wrong path rather than a "
            f"fresh start")
    with open(path) as fh:
        return json.load(fh)


def _issued_numbers(registry: dict) -> List[int]:
    prefix = registry.get("prefix", "ref")
    out = []
    for entry in registry.get("issued", []):
        name = str(entry.get("serial", ""))
        if name.startswith(prefix + "_"):
            tail = name[len(prefix) + 1:]
            if tail.isdigit():
                out.append(int(tail))
    return out


def next_serial(registry: dict) -> str:
    """One past the highest ever issued, never filling a gap.

    A gap means a sheet that was issued and then lost or discarded.
    Reusing its number would make two physical sheets answer to the
    same name, which is exactly what the serial exists to prevent.
    """
    numbers = _issued_numbers(registry)
    return f"{registry.get('prefix', 'ref')}_{max(numbers, default=0) + 1}"


def next_first_id(registry: dict, reserved: int = RESERVED_IDS) -> int:
    """The first marker id no issued sheet has claimed."""
    top = reserved
    for entry in registry.get("issued", []):
        first = entry.get("first_id")
        count = entry.get("count")
        squares = entry.get("squares")
        if first is None or count is None or squares is None:
            continue
        top = max(top, int(first) + int(count) * (int(squares) ** 2 // 2))
    return top


def issue_serial(path: str, serial: Optional[str] = None, *,
                 squares: int = 3, square_mm: float = 12.5, count: int = 4,
                 dictionary: str = "DICT_6X6_250",
                 first_id: Optional[int] = None,
                 artwork: Optional[str] = None) -> str:
    """Claim a serial and a block of marker ids, and record both.

    Writes the registry and a ``prints/<serial>.json`` stub beside it,
    so the caliper readings taken before the sheet is cut up have
    somewhere to land.
    """
    registry = load_registry(path)
    name = serial or next_serial(registry)
    if any(e.get("serial") == name for e in registry.get("issued", [])):
        raise ValueError(f"serial {name!r} has already been issued")

    per_board = (squares * squares) // 2
    n_ids = count * per_board
    start = next_first_id(registry) if first_id is None else int(first_id)
    available = DICTIONARY_SIZE.get(dictionary)
    if available is not None and start + n_ids > available:
        raise ValueError(
            f"{dictionary} is exhausted: ids {start}-{start + n_ids - 1} "
            f"were wanted and it holds {available}. DICT_6X6_1000 is "
            f"nested with DICT_6X6_250 -- the same pattern at the same "
            f"id -- so moving up costs nothing already printed")

    stub = os.path.join(os.path.dirname(os.path.abspath(path)), "prints",
                        f"{name}.json")
    if os.path.exists(stub):
        raise ValueError(
            f"a print record for {name!r} already exists at {stub!r}; "
            f"its measurements cannot be retaken, so it is never "
            f"overwritten")

    today = datetime.date.today().isoformat()
    entry = {"serial": name, "issued": today, "squares": squares,
             "square_mm": square_mm, "count": count,
             "first_id": start, "dictionary": dictionary}
    if artwork:
        entry["artwork"] = artwork
    registry.setdefault("issued", []).append(entry)
    registry.setdefault("kind", "target_serials")
    registry.setdefault("prefix", "ref")
    with open(path, "w") as fh:
        json.dump(registry, fh, indent=2)
        fh.write("\n")

    os.makedirs(os.path.dirname(stub), exist_ok=True)
    side = board_side_mm(squares, square_mm)
    with open(stub, "w") as fh:
        json.dump({
            "kind": "target_print", "name": name,
            "description": f"Print of a {count}-board {squares}x{squares} "
                           f"ChArUco sheet, serial {name}.",
            "artwork": {"file": artwork, "dictionary": dictionary},
            "printed": None, "printer": None,
            "nominal": {"square_mm": square_mm, "board_side_mm": side,
                        "cut_piece_mm": side + 16.0, "count": count},
            "pieces": [{"index": i,
                        "marker_ids": list(range(start + i * per_board,
                                                 start + (i + 1) * per_board))}
                       for i in range(count)],
            "measured": {"scale_x": None, "scale_y": None,
                         "scale_uniform": None, "square_mm": None,
                         "anisotropy_x_over_y": None},
            "_provenance": {
                "measured": "NOT YET TAKEN. Six caliper readings on each "
                            "printed span, outer edge to outer edge, WHILE "
                            "THE SHEET IS STILL INTACT -- after cutting "
                            "the longest baseline inside one piece is too "
                            "short to see the print error. See "
                            "docs/planning/measuring-the-printed-target.md.",
                "printer": "Record the make and the driver's scaling "
                           "setting. ref 1 came out 4.75 per cent "
                           "undersize because 'fit to printable area' was "
                           "left on.",
            },
        }, fh, indent=2)
        fh.write("\n")
    return name


def serial_filename(out: str, serial: str) -> str:
    """``out`` with the serial in it, so the file says what it is."""
    stem, ext = os.path.splitext(out)
    return out if serial in os.path.basename(stem) else f"{stem}-{serial}{ext}"


def _font(size_px: int):
    from PIL import ImageFont
    for path in ("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
                 "/usr/share/fonts/TTF/DejaVuSans.ttf",
                 "/Library/Fonts/Arial.ttf"):
        try:
            return ImageFont.truetype(path, size_px)
        except OSError:
            continue
    return ImageFont.load_default()


def render(squares: int, square_mm: float, marker_mm: float, count: int,
           sheet_mm: Tuple[float, float], px_per_mm: float,
           margin_mm: float, dictionary: str,
           first_id: int = 0,
           caliper_mm: Optional[float] = None,
           serial: str = "") -> np.ndarray:
    """The whole sheet, as an 8-bit greyscale array."""
    import cv2
    from PIL import Image, ImageDraw

    if not hasattr(cv2.aruco, dictionary):
        raise ValueError(f"unknown ArUco dictionary {dictionary!r}")
    known = cv2.aruco.getPredefinedDictionary(
        getattr(cv2.aruco, dictionary))
    per_board = (squares * squares) // 2
    wanted = first_id + count * per_board
    available = len(known.bytesList)
    if wanted > available:
        raise ValueError(
            f"not enough ids in the dictionary: {count} boards of "
            f"{squares}x{squares} need {count * per_board} markers from "
            f"{first_id}, and {dictionary} holds {available}")

    side = board_side_mm(squares, square_mm)
    centres = layout(count, side, margin_mm, sheet_mm, caliper_mm)

    def px(value: float) -> int:
        return int(round(value * px_per_mm))

    sheet = Image.new("L", (px(sheet_mm[0]), px(sheet_mm[1])), 255)
    draw = ImageDraw.Draw(sheet)
    font = _font(max(8, px(4.0)))
    label_font = _font(max(6, px(LABEL_EM_MM)))
    rule = max(1, px(0.15))

    # The label has to fit between the board and the cut line with
    # LABEL_CLEAR_MM of air below it and a little above, or it would
    # be printed onto the markers.
    _, _, _, ink_h = draw.textbbox((0, 0), "#0 ids", font=label_font)
    need_mm = LABEL_CLEAR_MM + ink_h / px_per_mm + 0.5
    if serial:
        sx0, _, sx1, _ = draw.textbbox((0, 0), serial, font=label_font)
        if (sx1 - sx0) / px_per_mm > side:
            raise ValueError(
                f"the serial {serial!r} prints "
                f"{(sx1 - sx0) / px_per_mm:.1f} mm wide, more than the "
                f"{side:.1f} mm board it names; shorten it or shrink "
                f"LABEL_EM_MM")
    if margin_mm < need_mm:
        raise ValueError(
            f"a {margin_mm:.1f} mm cut margin has no room for the "
            f"{LABEL_EM_MM} mm label, which needs {need_mm:.2f} mm "
            f"including its {LABEL_CLEAR_MM} mm clearance from the "
            f"board; widen the margin or shrink LABEL_EM_MM")

    for (name, ids), (cx, cy) in zip(
            enumerate(marker_ids(count, per_board, first_id)), centres):
        index, block = name, ids
        board = cv2.aruco.CharucoBoard((squares, squares), square_mm,
                                       marker_mm, known, block)
        image = board.generateImage((px(side), px(side)))
        sheet.paste(Image.fromarray(image),
                    (px(cx - side / 2), px(cy - side / 2)))
        # The cut line sits outside the board, never on it.  Cutting
        # along the board's own boundary is harmless -- the chessboard
        # corners are interior -- but cutting *inside* it destroys the
        # contrast a corner is made of, and a line drawn on the edge
        # invites exactly that.
        draw.rectangle([(px(cx - side / 2 - margin_mm),
                         px(cy - side / 2 - margin_mm)),
                        (px(cx + side / 2 + margin_mm),
                         px(cy + side / 2 + margin_mm))],
                       outline=128, width=rule)
        # Inside the cut box, so the label survives the scissors.
        # Left-aligned with the board and sitting LABEL_CLEAR_MM above
        # it, measured to the ink rather than to the baseline -- a
        # descender is ink too.
        text = (f"#{index}   ids {int(block[0])}-{int(block[-1])}   "
                f"{side:.1f} mm")
        bx0, _, _, by1 = draw.textbbox((0, 0), text, font=label_font)
        draw.text((px(cx - side / 2) - bx0,
                   px(cy - side / 2 - LABEL_CLEAR_MM) - by1),
                  text, fill=0, font=label_font)

        # The serial goes at the foot of the cut box, opposite the
        # piece label, because a cut piece has to say which *sheet*
        # it came from. Two prints of the same artwork look identical
        # and differ in scale, and the scale is what every measurement
        # taken through them inherits.
        if serial:
            ex0, _, _, ey1 = draw.textbbox((0, 0), serial, font=label_font)
            draw.text((px(cx - side / 2) - ex0,
                       px(cy + side / 2 + margin_mm - LABEL_CLEAR_MM) - ey1),
                      serial, fill=0, font=label_font)

    # No scale bar.  The sheet states what the corners *should*
    # measure and leaves the operator to check it with calipers on the
    # corners themselves; a printed bar would invite a reading whose
    # tick ambiguity alone is 0.40 %, against a 1.27 % print error.
    spans = caliper_spans(centres, squares, square_mm)
    notes = [
        f"square {square_mm} mm, marker {marker_mm} mm, {dictionary}, "
        f"{px_per_mm * 25.4:.0f} dpi",
        "MEASURE THE CORNERS, never an edge and never a printed bar.",
        f"furthest corners #0 to #1 (across): {spans['across']:.2f} mm",
        f"furthest corners #0 to #2 (down):   {spans['down']:.2f} mm",
        f"diagonals #0-#3 and #1-#2:          "
        f"{spans['diagonal_0_3']:.2f} mm each; a difference is shear",
    ]
    # Bottom-aligned to the page margin, so the last line stays out of
    # the printer's unprintable strip.
    line = px(5.5)
    foot = px(sheet_mm[1] - PAGE_MARGIN_MM) - len(notes) * line
    for row, text in enumerate(notes):
        draw.text((px(PAGE_MARGIN_MM), foot + row * line), text,
                  fill=0, font=font)
    return np.asarray(sheet, dtype=np.uint8)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--out", default="peg-targets.png")
    ap.add_argument("--squares", type=int, default=3,
                    help="squares per side of each board")
    ap.add_argument("--square-mm", type=float, default=12.5)
    ap.add_argument("--marker-mm", type=float, default=9.0)
    ap.add_argument("--count", type=int, default=4)
    ap.add_argument("--sheet-mm", default="215.9x279.4",
                    help="page size, width x height")
    ap.add_argument("--px-per-mm", type=float, default=20.0,
                    help="20 is 508 dpi exactly, which keeps every "
                         "square a whole number of pixels")
    ap.add_argument("--cut-margin-mm", type=float, default=8.0)
    ap.add_argument("--dictionary", default="DICT_6X6_250")
    ap.add_argument("--serial", default=None,
                    help="the sheet's serial; allocated from the registry "
                         "if not given")
    ap.add_argument("--registry", default=SERIAL_REGISTRY,
                    help="where issued serials and id blocks are recorded")
    ap.add_argument("--first-id", type=int, default=None,
                    help="override the id block the registry would "
                         "allocate; normally leave this alone")
    ap.add_argument("--caliper-mm", type=float, default=152.71,
                    help="how far the calipers open; the boards are "
                         "pulled together until every advertised span "
                         "fits.  0 spreads them to the page margins "
                         "instead, which reads longer and measures "
                         "nothing")
    args = ap.parse_args(argv)

    try:
        width, height = (float(v) for v in args.sheet_mm.lower().split("x"))
    except ValueError:
        print(f"--sheet-mm wants WIDTHxHEIGHT, not {args.sheet_mm!r}",
              file=sys.stderr)
        return 2
    try:
        registry = load_registry(args.registry)
    except ValueError as exc:
        print(f"{exc}", file=sys.stderr)
        return 1
    serial = args.serial or next_serial(registry)
    first_id = (next_first_id(registry) if args.first_id is None
                else args.first_id)

    try:
        sheet = render(args.squares, args.square_mm, args.marker_mm,
                       args.count, (width, height), args.px_per_mm,
                       args.cut_margin_mm, args.dictionary, first_id,
                       args.caliper_mm or None, serial)
    except ValueError as exc:
        print(f"{exc}", file=sys.stderr)
        return 1

    # The serial is claimed only once the sheet has actually rendered.
    # Serials are cheap but they are not reusable, so a typo must not
    # burn one.
    out = serial_filename(args.out, serial)
    try:
        issue_serial(args.registry, serial, squares=args.squares,
                     square_mm=args.square_mm, count=args.count,
                     dictionary=args.dictionary, first_id=first_id,
                     artwork=os.path.basename(out))
    except ValueError as exc:
        print(f"{exc}", file=sys.stderr)
        return 1

    from PIL import Image
    dpi = args.px_per_mm * 25.4
    Image.fromarray(sheet).save(out, dpi=(dpi, dpi))
    print(f"{out}: {sheet.shape[1]}x{sheet.shape[0]} px, "
          f"{width} x {height} mm at {dpi:.0f} dpi")
    print(f"   serial {serial}, marker ids {first_id}-"
          f"{first_id + args.count * (args.squares ** 2 // 2) - 1}, "
          f"{args.dictionary}")
    print(f"   {args.count} boards of {args.squares}x{args.squares} "
          f"squares at {args.square_mm} mm, "
          f"{board_side_mm(args.squares, args.square_mm):.1f} mm a side")
    side = board_side_mm(args.squares, args.square_mm)
    spans = caliper_spans(
        layout(args.count, side, args.cut_margin_mm, (width, height),
               args.caliper_mm or None),
        args.squares, args.square_mm)
    for name, value in spans.items():
        print(f"   {name:>12}: {value:8.2f} mm")
    print("   measure the corners after printing and record what you get")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
