#!/usr/bin/env python
"""Measure an ink signature from one frame of marked pegs.

Onboarding a new ink is shooting one frame and reading three numbers,
rather than guessing at a colour name.  Give it the frame and roughly
where the pegs are -- within a few tens of pixels is plenty, the
window is 140 px across by default:

    bin/measure-ink shot.png --calibration v4k_01.json \
        --name "Dykem Steel Blue"

With a calibration it finds the pegs itself, from the sheet outline
and the bar's geometry. Give --peg only to override that.

**Shoot a blank sheet.** The ink is on the pegs, so the drawing on the
paper adds nothing and can only mislead: the windows are sized for a
prediction rather than a measurement, and a drawn line inside one is
more saturated than a dark ink on chrome.

It prints an `ink` block to paste into a calibration JSON, or writes
it straight into one with --into.

The numbers are a property of *camera plus ink*, not of the ink alone.
Paper-referencing removes the illuminant but not the sensor, so a
different camera wants its own frame through here.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from typing import List, Tuple

import numpy as np
from PIL import Image

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
    "comfyui", "comfyui_acme"))

from acme.ink import measure_signature          # noqa: E402
from acme.model import Calibration               # noqa: E402
from acme.outline import (PREDICTED_RADIUS_PX,   # noqa: E402
                          predict_peg_windows)


def peg(text: str) -> Tuple[int, int]:
    try:
        x, y = text.split(",")
        return int(x), int(y)
    except ValueError:
        raise argparse.ArgumentTypeError(
            f"--peg wants x,y in pixels, not {text!r}")


def main(argv: List[str] = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("frame", help="a capture with the pegs marked")
    ap.add_argument("--peg", type=peg, action="append",
                    help="x,y of a peg, in pixels; repeat for each. "
                         "Omit it and give --calibration instead, which "
                         "is less error-prone and the recommended way")
    ap.add_argument("--calibration", default=None,
                    help="a calibration JSON, used to locate the pegs "
                         "from the sheet outline when --peg is absent")
    ap.add_argument("--name", default="",
                    help="what the ink is, for the record")
    ap.add_argument("--radius", type=int, default=None,
                    help="half-width of the window around each peg; "
                         "defaults to 70 with --peg and to "
                         f"{PREDICTED_RADIUS_PX} when the pegs are "
                         "predicted, which is wider because a prediction "
                         "carries the paper's bow")
    ap.add_argument("--into", default=None,
                    help="a calibration JSON to write the block into")
    args = ap.parse_args(argv)

    rgb = np.asarray(Image.open(args.frame).convert("RGB"), dtype=float)
    pegs, radius = args.peg, args.radius
    if pegs is None:
        source = args.calibration or args.into
        if source is None:
            print("give --peg, or --calibration so the pegs can be found "
                  "from the sheet outline", file=sys.stderr)
            return 2
        with open(source) as fh:
            calibration = Calibration.from_dict(json.load(fh))
        gray = (rgb @ np.array([0.2126, 0.7152, 0.0722])) / 255.0
        try:
            found = predict_peg_windows(gray, calibration)
        except ValueError as exc:
            print(f"{args.frame}: could not locate the pegs: {exc}",
                  file=sys.stderr)
            return 1
        pegs = [(int(round(x)), int(round(y))) for x, y in found]
        if radius is None:
            radius = PREDICTED_RADIUS_PX
        print(f"pegs predicted from the sheet outline at "
              f"{', '.join(f'{x},{y}' for x, y in pegs)}", file=sys.stderr)
    if radius is None:
        radius = 70
    try:
        signature = measure_signature(rgb, pegs, name=args.name,
                                      radius_px=int(radius))
    except ValueError as exc:
        print(f"{args.frame}: {exc}", file=sys.stderr)
        return 1

    block = dict(signature.__dict__)
    print(json.dumps({"ink": block}, indent=2))

    if args.into:
        with open(args.into) as fh:
            data = json.load(fh)
        data["ink"] = block
        with open(args.into, "w") as fh:
            json.dump(data, fh, indent=2)
        print(f"\nwrote the ink block into {args.into}", file=sys.stderr)

    if signature.tolerance_deg >= 45.0:
        print("\nTOLERANCE IS AT ITS CEILING.  The pixels in these windows "
              "do not agree on a hue, which usually means the windows are "
              "not on the pegs or the ink did not take.",
              file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
