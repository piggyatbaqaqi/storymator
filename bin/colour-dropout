#!/usr/bin/env python
"""Whiten light coloured pencil in an image and keep the graphite.

The command-line face of ComfyUI's ``ACME Colour Dropout`` node.  Both
call :func:`acme.dropout.dropout_colour`, so no ComfyUI server is needed
and the arithmetic is the node's own:

    bin/colour-dropout scan.png clean.png
    bin/colour-dropout scan.png clean.png --white-level 0.82 \
        --dropped removed.png

An existing output or mask file is refused unless --overwrite is given
(or COLOUR_DROPOUT_OVERWRITE is true).
That applies to any path, and the input gets no special treatment: with
--overwrite it can be replaced like anything else.

Parameters follow CLI --<flag>, then COLOUR_DROPOUT_<FLAG>, then the
default on ``dropout_colour``, and parsing is strict: see
docs/bin-argparse-strict.md.
"""

from __future__ import annotations

import argparse
import inspect
import os
import sys
from typing import Optional, Sequence

import numpy as np
from PIL import Image, ImageOps

from env_flags import apply_env

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
    "comfyui", "comfyui_acme"))

from acme.dropout import dropout_colour          # noqa: E402

SETTINGS = ("white_percentile", "white_level", "mark_level")


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("input", help="the image to read")
    ap.add_argument("output", help="where to write graphite on white")
    ap.add_argument("--white-percentile", type=float, default=None,
                    help="brightness percentile taken as the paper "
                         f"(default {_library_default('white_percentile')})")
    ap.add_argument("--white-level", type=float, default=None,
                    help="fraction of paper white at or above which a "
                         "pixel's brightest channel renders white "
                         f"(default {_library_default('white_level')})")
    ap.add_argument("--mark-level", type=float, default=None,
                    help="only affects --dropped: luminance below this "
                         "fraction of paper white counts as a mark "
                         f"(default {_library_default('mark_level')})")
    ap.add_argument("--dropped", default=None, metavar="PATH",
                    help="also write a mask of the marks that were whitened")
    ap.add_argument("--overwrite", action="store_true",
                    help="replace files that already exist")
    apply_env(ap, "COLOUR_DROPOUT", exempt={"dropped"})
    return ap


def _library_default(name: str) -> float:
    """One set of defaults: the library's, which the node mirrors."""
    default = inspect.signature(dropout_colour).parameters[name].default
    return float(default)


def _read(path: str) -> np.ndarray:
    """(H, W, 3) floats in 0-1, upright, as LoadImage hands the node."""
    with Image.open(path) as image:
        # Pillow's conversion clips these to white: a blank page, and
        # nothing to say anything went wrong.
        if image.mode.startswith(("I", "F")):
            raise ValueError(f"{image.mode} images are not supported; "
                             "convert to 8 bits per channel first")
        upright = ImageOps.exif_transpose(image).convert("RGB")
    return np.asarray(upright, dtype=float) / 255.0


def _refusal(output: str, mask: Optional[str],
             overwrite: bool) -> Optional[str]:
    """Why these paths must not be written, checked before any are."""
    paths = [output] if mask is None else [output, mask]
    if mask is not None and os.path.realpath(mask) == os.path.realpath(output):
        return f"{output}: the output and --dropped are the same file"
    if not overwrite:
        for path in paths:
            # lexists, so that a dangling link counts: writing through
            # it would create the file it names.
            if os.path.lexists(path):
                return f"{path}: already exists; use --overwrite to replace it"
    return None


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    # None means neither the command line nor the environment said, which
    # leaves the library's own default in force.
    settings = {name: getattr(args, name) for name in SETTINGS
                if getattr(args, name) is not None}
    refusal = _refusal(args.output, args.dropped, args.overwrite)
    if refusal is not None:
        print(refusal, file=sys.stderr)
        return 2

    try:
        rgb = _read(args.input)
    except (OSError, ValueError) as exc:
        print(f"{args.input}: {exc}", file=sys.stderr)
        return 1
    try:
        result = dropout_colour(rgb, **settings)
    except ValueError as exc:
        print(f"{args.input}: {exc}", file=sys.stderr)
        return 2

    gray = np.round(result.gray * 255.0).astype(np.uint8)
    written = [(args.output, gray)]
    if args.dropped is not None:
        written.append((args.dropped, result.dropped.astype(np.uint8) * 255))
    for path, pixels in written:
        try:
            Image.fromarray(pixels).save(path)
        except (OSError, ValueError) as exc:
            print(f"{path}: {exc}", file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
