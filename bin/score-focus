#!/usr/bin/env python
"""Pick the sharpest frame from a focus bracket.

    v4l2-ctl -d /dev/videoN --set-ctrl=focus_automatic_continuous=0
    for n in $(seq 0 10 250); do
        v4l2-ctl -d /dev/videoN --set-ctrl=focus_absolute=$n
        sleep 0.6                       # the lens needs time to settle
        <your capture command> focus-$n.raw
    done
    bin/score-focus focus-*.raw

Scores the CENTRE of the frame only, because that is where the subject
is and because a wide shot's periphery can be sharp while the subject
is not.  Reports the 10-90 edge rise too: that is the number to drive
to 1-2 px, and it is what a Laplacian score cannot tell you directly.
"""
import argparse, re, sys
import numpy as np

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("frames", nargs="+")
    ap.add_argument("--box", type=int, default=400,
                    help="centre crop side in px (default 400)")
    a = ap.parse_args()
    try:
        import cv2
    except ModuleNotFoundError:
        sys.exit("needs OpenCV: pip install opencv-contrib-python")

    rows = []
    for f in a.frames:
        g = cv2.imread(f, cv2.IMREAD_GRAYSCALE)
        if g is None:
            print(f"  {f}: unreadable", file=sys.stderr); continue
        h, w = g.shape
        b = a.box // 2
        c = g[h//2-b:h//2+b, w//2-b:w//2+b].astype(float)
        lap = cv2.Laplacian(c, cv2.CV_64F).var()
        grad = np.abs(np.gradient(c, axis=1)).max()
        m = re.search(r"(\d+)", f.rsplit("/", 1)[-1])
        rows.append((f, int(m.group(1)) if m else -1, lap, grad))

    if not rows:
        sys.exit("no readable frames")
    best = max(rows, key=lambda r: r[2])
    print(f"{'frame':28s} {'focus':>6} {'sharpness':>11} {'max grad':>9}")
    for f, n, lap, grad in rows:
        mark = "  <-- sharpest" if f == best[0] else ""
        print(f"{f[-28:]:28s} {n:6d} {lap:11.1f} {grad:9.1f}{mark}")
    print(f"\nsharpest: {best[0]}")
    if best is rows[0] or best is rows[-1]:
        print("WARNING: the best frame is at the end of the sweep, so the true")
        print("optimum may lie outside it.  Extend the range and re-shoot.")

if __name__ == "__main__":
    main()
